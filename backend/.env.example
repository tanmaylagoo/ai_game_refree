# ============================================================
# FairPlay AI Backend Environment Configuration Template
# Copy this file to .env and provide your actual secrets.
# DO NOT commit your .env file to version control.
# ============================================================

# LLM Providers
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/
MONGO_DB_NAME=ai_game_referee

# JWT Authentication Secret (Use a secure, randomly generated string in production)
JWT_SECRET=your_super_secret_production_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated allowed origins for production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

